# SERVER ONLY. Copy to a private environment file that is never committed.
# The static demo keeps working without this backend. No account service activates by default.
EMET_AUTH_ENABLED=false
EMET_APP_ORIGIN=https://your-emet-domain.example
SUPABASE_URL=https://your-reviewed-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random bytes; never use a demo password here.
EMET_RATE_LIMIT_SECRET=
RESEND_API_KEY=
EMET_FROM_EMAIL=Emet <accounts@your-verified-domain.example>
# Enable only after configuring and testing Supabase secure email changes + SMTP.
EMET_SECURE_EMAIL_CHANGE_CONFIGURED=false
# Local HTTP is opt-in, never available under NODE_ENV=production.
EMET_ALLOW_LOCAL_HTTP=false
