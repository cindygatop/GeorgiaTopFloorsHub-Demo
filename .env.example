# SERVER ONLY. Copy to a private environment file that is never committed.
# The static demo keeps working without this backend. No account service activates by default.
EMET_AUTH_ENABLED=false
EMET_APP_ORIGIN=https://your-emet-domain.example
SUPABASE_URL=https://your-reviewed-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate at least 32 random bytes; never use a demo password here.
EMET_RATE_LIMIT_SECRET=
RESEND_API_KEY=
EMET_FROM_EMAIL=Emet <accounts@your-verified-domain.example>
# Enable only after configuring and testing Supabase secure email changes + SMTP.
EMET_SECURE_EMAIL_CHANGE_CONFIGURED=false
# Local HTTP is opt-in, never available under NODE_ENV=production.
EMET_ALLOW_LOCAL_HTTP=false

# Ruach generative chat is server-only and disabled until account access is ready.
# Select an exact language model with structured-output in the current catalog:
# https://ai-gateway.vercel.sh/v1/models
EMET_RUACH_ENABLED=false
AI_GATEWAY_MODEL=
# Leave empty on Vercel when the platform-provided OIDC token is used.
AI_GATEWAY_API_KEY=
# Set true only after verifying the applicable Gateway monetary budget/alerts.
# This flag does not create a provider budget. No BYOK fallback is configured here.
EMET_RUACH_BUDGET_CONFIGURED=false
# Distributed org-wide hourly request cap (1-100); six requests/user/minute also apply.
EMET_RUACH_HOURLY_LIMIT=30
